# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here   # any secret string you choose

# ── OpenAI (GPT-4.1 + Whisper) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Sheets OAuth ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Ledger Spreadsheet ────────────────────────────────────────────────────────
# The ID of your Google Sheet (from the URL: /spreadsheets/d/<SPREADSHEET_ID>/)
SPREADSHEET_ID=your_spreadsheet_id_here
LEDGER_SHEET_NAME=Ledger

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── LLM Model ────────────────────────────────────────────────────────────────
DEFAULT_MODEL=gpt-4.1
